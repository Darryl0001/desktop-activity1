  "components": {
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "description": "Opaque resource ID returned by the API."
      },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Trimmed case-insensitive literal partial matching."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "schema": {
          "type": "string"
        },
        "description": "Optional revision tag from the relevant resource ETag."
      },
      "Available": {
        "name": "available",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "Status": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "Active",
            "Returned",
            "All"
          ],
          "default": "All"
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "borrowedDate",
            "expectedReturnDate"
          ],
          "default": "borrowedDate"
        }
      },
      "Direction": {
        "name": "direction",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      }
    },
    "schemas": {
      "Student": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "studentNumber",
          "fullName",
          "isEligible"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "studentNumber": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "nullable": true
          },
          "isEligible": {
            "type": "boolean"
          }
        }
      },
      "Equipment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "equipmentCode",
          "name",
          "isAvailable"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "equipmentCode": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isAvailable": {
            "type": "boolean"
          }
        }
      },
      "Borrowing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "studentId",
          "equipmentId",
          "borrowedDate",
          "expectedReturnDate",
          "returnedDate",
          "status",
          "studentNumber",
          "studentName",
          "equipmentCode",
          "equipmentName"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "studentId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "equipmentId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "borrowedDate": {
            "type": "string",
            "format": "date"
          },
          "expectedReturnDate": {
            "type": "string",
            "format": "date"
          },
          "returnedDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Returned"
            ]
          },
          "studentNumber": {
            "type": "string"
          },
          "studentName": {
            "type": "string"
          },
          "equipmentCode": {
            "type": "string"
          },
          "equipmentName": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "StudentCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentNumber",
          "fullName"
        ],
        "properties": {
          "studentNumber": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "nullable": true,
            "minLength": 1
          }
        }
      },
      "StudentUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentNumber",
          "fullName",
          "contact"
        ],
        "properties": {
          "studentNumber": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EquipmentCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equipmentCode",
          "name"
        ],
        "properties": {
          "equipmentCode": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EquipmentUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equipmentCode",
          "name",
          "description"
        ],
        "properties": {
          "equipmentCode": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Eligibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "isEligible"
        ],
        "properties": {
          "isEligible": {
            "type": "boolean"
          }
        }
      },
      "BorrowingCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "equipmentId",
          "expectedReturnDate"
        ],
        "properties": {
          "studentId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "equipmentId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "expectedReturnDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CheckoutCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "equipmentIds",
          "expectedReturnDate"
        ],
        "properties": {
          "studentId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "equipmentIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
