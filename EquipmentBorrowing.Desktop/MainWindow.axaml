<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:EquipmentViewModel">
            <views:EquipmentView/>
        </DataTemplate>
        <DataTemplate DataType="vm:BorrowingsViewModel">
            <views:BorrowingsView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="180,*">
        <StackPanel Grid.Column="0" Margin="10" Spacing="8" Background="#3d3d3d">
            <TextBlock Text="Campus Equipment" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}" HorizontalAlignment="Stretch"/>
            <Button Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}" HorizontalAlignment="Stretch"/>
        </StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="10"/>
    </Grid>
</Window>