<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="Student ID:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding StudentIdInput}" Width="80"/>
            <TextBlock Text="Return by:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding SelectedReturnDate}"/>
            <Button Content="Borrow Equipment" Command="{Binding BorrowCommand}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Equipment}"
                 SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Id}" Width="40"/>
                        <TextBlock Text="{Binding Name}" Width="200"/>
                        <TextBlock Text="{Binding IsAvailable}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>